# Database (PostgreSQL)
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_DATABASE=n8n_library
DB_POSTGRESDB_SCHEMA=public

# Application
PORT=3100
SESSION_SECRET=change-me-to-a-random-64-char-string
# Required in production. Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
APP_URL=http://localhost:3100
# Frontend: react (default in Docker) or legacy
FRONTEND=react
# NODE_ENV=production

# n8n Instance (optional — can be configured in UI)
# N8N_INTERNAL_URL=http://localhost:5678
# N8N_API_KEY=your-n8n-api-key

# n8n login (optional) — set to true only in trusted deployments. Otherwise
# users must already have a provisioned library account.
# N8N_LOGIN_AUTO_PROVISION=false

# Outbound request signing (optional). Recipients can verify
# X-N8N-Library-Signature: sha256=<hmac of the raw JSON body>.
# WEBHOOK_SIGNING_SECRET=
# HITL_CALLBACK_SECRET=

# Private-network destinations are blocked by default. Enable only when
# intentionally sending webhooks/HITL callbacks to internal services.
# WEBHOOK_ALLOW_PRIVATE=false
# HITL_ALLOW_PRIVATE_CALLBACKS=false

# OpenTelemetry trace query backend (n8n exports traces via OTLP)
# POC default: Jaeger all-in-one. For production, point at Tempo.
OTEL_BACKEND=jaeger
OTEL_QUERY_URL=http://jaeger:16686
OTEL_PUBLIC_URL=http://localhost:16686
OTEL_SERVICE_NAME=n8n
# OTEL_QUERY_AUTH_HEADER=Bearer ...

# Data retention (days)
# AUDIT_RETENTION_DAYS=180
# CREDENTIAL_AUDIT_RETENTION_DAYS=365
# NOTIFICATION_RETENTION_DAYS=30
# RESET_TOKEN_RETENTION_DAYS=7

# Email / SMTP (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
